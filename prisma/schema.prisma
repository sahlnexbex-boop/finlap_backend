datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String?
  avatarUrl     String?
  country       String?
  sex           String?
  place         String?
  phone         String?
  currency      String   @default("INR")
  memberTier    String   @default("Platinum Member")
  proBadge      Boolean  @default(true)
  biometrics    Boolean  @default(true)
  notifications Boolean  @default(true)
  securityPin   String   @default("1234")
  theme         String   @default("Midnight Slate")
  language      String   @default("English (US)")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BusinessEntity {
  id           String        @id @default(uuid())
  userId       String
  name         String
  subtitle     String?
  isPrimary    Boolean       @default(false)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   // "bank", "cash", "credit_card", "digital_wallet"
  balance   Float    @default(0)
  icon      String   @default("landmark")
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String   @default("tag")
  color     String   @default("#8B5CF6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String
  accountNo   String
  balance     Float
  currency    String   @default("INR")
  cardHolder  String
  expiry      String
  cardType    String
  colorAccent String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String
  title            String
  merchant         String
  amount           Float
  type             Int             @db.SmallInt // 1 = income, 0 = expense
  category         String
  date             String
  time             String
  status           String          @default("COMPLETED")
  walletId         String?
  walletName       String?
  businessEntityId String?
  businessEntity   BusinessEntity? @relation(fields: [businessEntityId], references: [id])
  businessName     String?
  note             String?
  fundingSource    String?         @default("Chase Business")
  isRecurring      Boolean         @default(false)
  attachment       String?
  icon             String          @default("building")
  createdAt        DateTime        @default(now())
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Float
  spent     Float    @default(0.0)
  icon      String
  color     String
  period    String   @default("MONTHLY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

model Goal {
  id         String   @id @default(uuid())
  userId     String
  title      String
  target     Float
  current    Float
  category   String
  targetDate String
  color      String
  createdAt  DateTime @default(now())
}

model NetWorthHistory {
  id          String   @id @default(uuid())
  userId      String
  month       String
  netWorth    Float
  assets      Float
  liabilities Float
  createdAt   DateTime @default(now())
}
